# Project configuration (non-sensitive settings)
# These settings can be safely version-controlled
project:
  # Git repository settings (GitHub/GitLab)
  git_url: "https://github.com"
  git_repo_owner: "konflux-ci"  # Repository owner/organization
  git_repo_name: "konflux-ui"   # Repository name

  # For GitLab:
  # git_url: "https://gitlab.com"  # Or your GitLab instance URL
  # git_repo_owner: "myorg"
  # git_repo_name: "myproject"

  # Environment variables (override config values):
  #   GIT_TOKEN: Git platform access token (or use GITHUB_TOKEN/GITLAB_TOKEN)
  #   GIT_VERIFY_SSL: Verify SSL certificates (default: true, set to 'false' for self-signed certs)

phases:
  - name: "No AI Period"
    start: "2024-10-24"
    end: "2025-05-31"
  - name: "Cursor Period"
    start: "2025-06-01"
    end: "2025-07-31"
  - name: "Full AI Period"
    start: "2025-08-01"
    end: "2025-11-08"

default_author: "" # "" represent team

members:
  # For consistent anonymization across Jira and PR reports:
  # - Add 'email' field with the same email used in Jira config
  # - This ensures the same person gets the same anonymous hash in both reports
  # - The 'name' field is the GitHub username
  #
  # Optional fields for accurate Daily Throughput calculations:
  # - leave_days: Days on leave during the phase (single value or per-phase list)
  # - capacity: Work capacity 0.0-1.0 (1.0=full time, 0.5=half time, single value or per-phase list)

  - email: sbudhwar@redhat.com  # Same email as in Jira config
    git_username: sahil143
    leave_days: 0 # Optional when it is 0
    capacity: 1 # Optional when it is 1
  - email: wlin@redhat.com
    git_username: testcara
    leave_days:
      - 26
      - 20
      - 11.5
    capacity: 0.8


# Send Hashed Develop ID to individuals.
# Required by CI for first-time run.
# Disabled it if you do not want to be mailed every run.
email_anonymous_id: true

# Simple scenario (optional)
output_dir: "reports/jira"
# Multiple scenario (required):
# output_dir: "reports/internal-services/jira"  # For config/my-team/internal-services/pr_report_config.yaml
# output_dir: "reports/frontend/jira"           # For config/my-team/frontend/pr_report_config.yaml

# delete old sheets with same name but different timestamp(Recommend)
# replace_existing_reports: true

# AI Analysis (optional)
# AI-powered analysis is enabled by default. Set to true to disable.
# When enabled: Generates analysis prompts and AI insights (if GOOGLE_API_KEY is configured)
# When disabled: Skips prompt and analysis generation (faster processing, no API costs)
# no_ai_analysis: true

# Monthly AI Trend chart (optional)
# When enabled, reads all pr_metrics JSON files and generates a bar+line chart
# showing AI vs Human commit volume per month with an AI% trend line.
# Uploaded as a "Monthly AI Trend" tab in Google Sheets.
# monthly_trend: true

# Monthly Comparison (optional)
# When enabled, generates an additional report comparing two consecutive months,
# uploaded as a separate "Monthly Comparison" tab in Google Sheets.
# monthly_comparison: true
#
# By default, compares the previous calendar month with the current month (up to today).
# To pin comparison to a specific pair (e.g. April vs May), set comparison_reference_date
# to the last day of the later month:
#   comparison_reference_date: "2026-05-31"  # → April 2026 vs May 2026
# Leave unset (or omit) to always compare the two most recent months automatically.

# Google Sheets settings (optional)
# google_spreadsheet_id: ""  # Google Spreadsheet ID for report upload
# If you do not set in Config PR, reports would be uploaded to the default google-sheet by CI.
# IMPORTANT: For custom sheets in CI, grant Editor access to: cara-google-sheet-sa@wlin-438107.iam.gserviceaccount.com
